# Substituir pelo dominio real. TLS automatico via Let's Encrypt (HTTP-01 challenge).
seu-dominio.exemplo.com {
    encode gzip
    reverse_proxy app:3003
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
